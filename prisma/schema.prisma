
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id                 String   @id @default(cuid())
  name               String
  email              String
  projectDescription String?  @db.Text
  bookingDate        DateTime
  bookingTime        String
  status             String   @default("PENDING")
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("bookings")
}
